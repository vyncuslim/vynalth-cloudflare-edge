# REVIEW-ONLY: disabled until dedicated isolated node is provisioned.
[Unit]
Description=Run bounded offline honeypot collection for %i once per minute

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=5s
Persistent=true
Unit=vynalth-honeypot-collector@%i.service

[Install]
WantedBy=timers.target
