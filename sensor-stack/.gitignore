# Raw honeypot evidence can contain passwords, IP addresses and malware.
# NEVER commit any local runtime, sample or session recordings.
runtime/
*.log
*.jsonl
*.tty
*.session
*.sample
*.bin
.env
.env.*
__pycache__/
.pytest_cache/

# Persistent privacy-sensitive evidence queue and its SQLite sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
private/
spool/
tty/
downloads/
manifests/
